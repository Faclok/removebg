{
  "Database": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=removebg-local.db"
  },
  "Removal": {
    "ExecutionProvider": "Cpu",
    "CoreMlModelFormat": "NeuralNetwork",
    "CoreMlComputeUnits": "CPUAndGPU",
    "CpuWorkers": 2,
    "IntraOpThreads": 3,
    "QueueCapacity": 4,
    "QueueWaitSeconds": 30,
    "PngCompressionLevel": 1
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
