{
  "Database": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=removebg-local.db"
  },
  "Removal": {
    "ExecutionProvider": "Cpu",
    "CoreMlModelFormat": "NeuralNetwork",
    "CoreMlComputeUnits": "CPUAndGPU",
    "CpuWorkers": 1,
    "IntraOpThreads": 6,
    "QueueCapacity": 2,
    "PngCompressionLevel": 1,
    "MaxAttempts": 3,
    "ProcessingTimeoutSeconds": 300,
    "RetryDelaySeconds": 2
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
