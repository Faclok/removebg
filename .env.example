ASPNETCORE_ENVIRONMENT=Production
MYSQL_DATABASE=removebg
MYSQL_USER=removebg
MYSQL_PASSWORD=change-me-to-a-long-random-database-password
MYSQL_ROOT_PASSWORD=change-me-to-a-different-long-root-password
Accounts__StartingBalanceKopecks=100000
# SMTP для отправки пароля после регистрации:
Email__Host=smtp.example.com
Email__Port=587
Email__EnableSsl=true
Email__Username=mailer@example.com
Email__Password=change-me-to-the-smtp-password
Email__FromAddress=mailer@example.com
Email__FromName=Удалифон
Email__LoginUrl=https://removebg.example.com/
Removal__InputSize=512
Removal__CpuWorkers=1
Removal__IntraOpThreads=6
Removal__QueueCapacity=2
Removal__QueueWaitSeconds=30
Removal__PngCompressionLevel=1
Removal__MaxUploadBytes=15728640
Removal__MaxImagePixels=40000000
API_CPU_LIMIT=6
API_MEMORY_LIMIT=20G
# Обязательно замените перед использованием административного API:
Admin__Token=change-me-to-a-long-random-value
